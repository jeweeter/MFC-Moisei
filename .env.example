# Ключ Anthropic API. Без него система работает в автономном режиме:
# поиск и мастер по жизненной ситуации функционируют полностью, а ассистент
# отвечает выдержками из базы знаний без генерации.
ANTHROPIC_API_KEY=

# Модель и лимиты
MOISEI_LLM_MODEL=claude-sonnet-5
MOISEI_LLM_MAX_TOKENS=1600

# Цены за 1M токенов (USD) — для подсчёта экономии на кэше
MOISEI_PRICE_IN=3.0
MOISEI_PRICE_OUT=15.0

# Поиск и кэш
MOISEI_TOP_K=12
MOISEI_CACHE_TTL_DAYS=30
