{
  "version": "2026.09",
  "comment": "Онтология типовых документов. Нужна для сведения перечней разных услуг в один чек-лист: в регламентах один и тот же паспорт описан десятком формулировок («документ, удостоверяющий личность», «оригинал паспорта либо иного документа...», «паспорт гражданина РФ»). match — регулярные выражения по нормализованному (нижний регистр, ё→е) тексту пункта. exclude — исключения, чтобы не путать смежные документы.",
  "types": [
    {"id": "id_doc", "label": "Документ, удостоверяющий личность (паспорт)", "critical": true,
     "match": ["документ[а-я]*,? удостоверяющ[а-я]+ личност", "паспорт гражданина", "^паспорт\\b", "оригинал паспорта"],
     "exclude": ["за пределами территории", "представител", "транспортн", "техническ", "кадастров"]},
    {"id": "rep_doc", "label": "Документ, подтверждающий полномочия представителя (доверенность)", "critical": false,
     "match": ["полномочи[а-я]+ представител", "доверенност", "удостоверяющ[а-я]+ полномочи"], "exclude": []},
    {"id": "snils", "label": "СНИЛС (страховой номер лицевого счёта)", "critical": false,
     "match": ["снилс", "страхово[а-я]* свидетельств[а-я]* обязательного пенсионного", "номер индивидуального лицевого счета"], "exclude": []},
    {"id": "birth_cert", "label": "Свидетельство о рождении ребёнка", "critical": false,
     "match": ["свидетельств[а-я]* о рождении", "документ[а-я]*,? подтверждающ[а-я]+ рождени"], "exclude": []},
    {"id": "marriage_cert", "label": "Свидетельство о браке / о расторжении брака", "critical": false,
     "match": ["свидетельств[а-я]* о (заключении|расторжении) брака", "свидетельств[а-я]* о браке"], "exclude": []},
    {"id": "death_cert", "label": "Свидетельство о смерти", "critical": false,
     "match": ["свидетельств[а-я]* о смерти"], "exclude": []},
    {"id": "application", "label": "Заявление установленной формы", "critical": true,
     "match": ["^заявлени", "заявлени[а-я]* по форме", "заявлени[а-я]* установленн[а-я]+ формы", "заполненн[а-я]+ заявлени", "анкет[аы]"], "exclude": []},
    {"id": "bank", "label": "Реквизиты счёта в банке", "critical": false,
     "match": ["реквизит[а-я]* счета", "реквизит[а-я]* банк", "сведени[а-я]* о банковском счете", "номер счета"], "exclude": []},
    {"id": "income", "label": "Документы о доходах семьи", "critical": false,
     "match": ["о доходах", "справк[а-я]* о заработной", "сведени[а-я]* о доходах"], "exclude": []},
    {"id": "family", "label": "Справка о составе семьи / о регистрации по месту жительства", "critical": false,
     "match": ["состав[еа]? семьи", "о регистрации по месту (жительства|пребывания)", "справк[а-я]* с места жительства", "выписк[а-я]* из домовой книги"], "exclude": []},
    {"id": "work", "label": "Трудовая книжка / сведения о трудовой деятельности", "critical": false,
     "match": ["трудов[а-я]+ книжк", "сведени[а-я]* о трудовой деятельности", "о страховом стаже"], "exclude": []},
    {"id": "military", "label": "Военный билет / удостоверение военнослужащего", "critical": false,
     "match": ["военн[а-я]+ билет", "удостоверени[а-я]* (ветерана|участника)", "справк[а-я]* из воинской части"], "exclude": []},
    {"id": "realty", "label": "Правоустанавливающие документы на недвижимость", "critical": false,
     "match": ["правоустанавливающ", "договор купли-продажи", "выписк[а-я]* из егрн", "свидетельств[а-я]* о (государственной регистрации права|праве собственности)"], "exclude": []},
    {"id": "duty", "label": "Квитанция об оплате государственной пошлины", "critical": false,
     "match": ["государственн[а-я]+ пошлин", "квитанци", "об оплате пошлины", "платежн[а-я]+ документ"], "exclude": []},
    {"id": "photo", "label": "Фотографии", "critical": false,
     "match": ["фотографи", "личн[а-я]+ фото"], "exclude": []},
    {"id": "medical", "label": "Медицинские документы (заключение, справка)", "critical": false,
     "match": ["медицинск[а-я]+ (заключени|справк|документ)", "справк[а-я]* об инвалидности", "выписк[а-я]* из истории болезни", "заключени[а-я]* врачебной"], "exclude": []},
    {"id": "residence", "label": "Документы о месте жительства / праве пользования жильём", "critical": false,
     "match": ["договор (социального )?найма", "согласи[а-я]* собственника", "право пользования жилым"], "exclude": []},
    {"id": "foreign", "label": "Документы иностранного гражданина (ВНЖ, РВП, миграционная карта)", "critical": false,
     "match": ["вид на жительство", "разрешени[а-я]* на временное проживание", "миграционн[а-я]+ карт", "документ[а-я]* иностранного гражданина"], "exclude": []},
    {"id": "guardianship", "label": "Документы опеки / попечительства", "critical": false,
     "match": ["акт органа опеки", "решени[а-я]* об установлении опеки", "постановлени[а-я]* об опеке"], "exclude": []}
  ]
}
